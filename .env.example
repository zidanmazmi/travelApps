# ================================================================
# WHITE-LABEL TRAVEL PLATFORM - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill values for each deployment.
# NEVER commit .env.
# ================================================================

CI_ENVIRONMENT = development

# APP
app.baseURL = 'http://localhost:8080/'

# DATABASE
# Create this database before importing database/schema.sql.
database.default.hostname = localhost
database.default.database = travel_white_label
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ENCRYPTION
# Generate a random key for production. Do not reuse between clients.
encryption.key =

# EMAIL / SMTP
email.fromEmail =
email.fromName = 'Travel Platform'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.gmail.com'
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'
email.charset = 'UTF-8'
email.wordWrap = true
email.SMTPTimeout = 30

# MIDTRANS - PER INSTANCE
midtrans.serverKey =
midtrans.clientKey =
midtrans.isProduction = false
midtrans.isSanitized = true
midtrans.is3ds = true

# GEMINI / CHATBOT AI - PER INSTANCE
CHATBOT_AI_ENABLED = true
GEMINI_API_KEY =
GEMINI_BASE_URL = 'https://generativelanguage.googleapis.com/v1beta'
GEMINI_UPLOAD_BASE_URL = 'https://generativelanguage.googleapis.com/upload/v1beta'
GEMINI_CHAT_MODEL = 'gemini-3.5-flash-lite'
GEMINI_DOCUMENT_MODEL = 'gemini-3.5-flash'
GEMINI_EMBEDDING_MODEL = 'gemini-embedding-001'
GEMINI_EMBEDDING_DIMENSIONS = 768
GEMINI_REQUEST_TIMEOUT = 120
GEMINI_MAX_DOCUMENT_BYTES = 52428800

# GENERIC CLIENT SEEDER
# Used only for a fresh instance bootstrap.
SEED_ADMIN_NAME = 'Super Admin'
SEED_ADMIN_EMAIL =
SEED_ADMIN_PASSWORD =
